<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/ts_page_pad"
        android:paddingTop="4dp"
        android:paddingEnd="@dimen/ts_page_pad"
        android:paddingBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/server_ip_label"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/ipPortSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="100"
                android:importantForAutofill="no"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/showPortTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pinButton"
            style="@style/Widget.Textsend.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ts_btn"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"
            android:visibility="gone"
            tools:text="PIN  12345678"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sessionButton"
            style="@style/Widget.Textsend.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ts_btn"
            android:layout_marginTop="6dp"
            android:text="@string/server_session_idle"
            tools:visibility="visible" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/server_send_target"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:endIconMode="dropdown_menu">

            <AutoCompleteTextView
                android:id="@+id/sendTargetSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="100"
                android:importantForAutofill="no"
                android:inputType="none"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/server_send_target_hint"
            android:textAppearance="@style/TextAppearance.Textsend.Hint" />

        <LinearLayout
            android:id="@+id/webFileBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/webFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="photo.jpg" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/webFileProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="1000"
                    app:trackCornerRadius="99dp" />

                <TextView
                    android:id="@+id/webFileMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="收  42%" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/webFileCancel"
                style="@style/Widget.Textsend.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ts_btn"
                android:layout_marginStart="8dp"
                android:text="@string/messager_cancel_btn" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/authPendingBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/authPendingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_auth_pending_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <LinearLayout
                android:id="@+id/authPendingList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aliveClientsBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/aliveClientsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_alive_clients_title"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <LinearLayout
                android:id="@+id/aliveClientsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <ImageView
            android:id="@+id/qrImageView"
            android:layout_width="196dp"
            android:layout_height="196dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_qr"
            android:clickable="true"
            android:contentDescription="@string/server_content_description"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_textsend" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/multiClientBtn"
            style="@style/Widget.Textsend.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ts_btn"
            android:layout_marginTop="12dp"
            android:text="@string/server_switch_btn_multi" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/serverStartBtn"
            style="@style/Widget.Textsend.Button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ts_btn"
            android:layout_marginTop="6dp"
            android:text="@string/server_start_btn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/webBridgeBtn"
            style="@style/Widget.Textsend.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ts_btn"
            android:layout_marginTop="6dp"
            android:text="@string/server_web_btn" />

        <TextView
            android:id="@+id/serverTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/message_fragment_label"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="@string/server_copy_hint" />
    </LinearLayout>
</ScrollView>
