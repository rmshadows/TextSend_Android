    <string name="settings_auth_rate_invalid">限流须为 1–60</string>
    <string name="settings_auth_cooldown">拒绝后冷却（秒）</string>
    <string name="settings_auth_cooldown_hint">拒绝或超限后，该 IP 多久内不再弹出请求，默认 10。填 0 表示不冷却。改短对已经在冷却的地址立刻生效。</string>
