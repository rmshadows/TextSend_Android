        <item name="colorSecondaryContainer">#E8E4DB</item>
        <item name="colorOnSecondaryContainer">#1A1A1A</item>
        <item name="colorTertiary">#3F3B34</item>
        <item name="colorOnTertiary">#F6F4EF</item>
        <item name="colorTertiaryContainer">#E8E4DB</item>
        <item name="colorOnTertiaryContainer">#1A1A1A</item>
