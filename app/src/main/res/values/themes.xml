        <item name="colorSecondaryContainer">#243056</item>
        <item name="colorOnSecondaryContainer">#D6E0FF</item>
        <item name="colorTertiary">#B8C4E8</item>
        <item name="colorOnTertiary">#0B1020</item>
        <item name="colorTertiaryContainer">#243056</item>
