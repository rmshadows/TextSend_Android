<resources>
    <!-- 默认：紫强调，跟随系统浅/深。 -->
    <style name="Base.Theme.Textsend" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#5C00FF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#EDE4FF</item>
        <item name="colorOnPrimaryContainer">#2A006E</item>
