        <item name="colorTertiaryContainer">#2A2B2E</item>
        <item name="colorOnTertiaryContainer">#E8EAED</item>
        <item name="android:colorBackground">#0C0C0D</item>
        <item name="android:windowBackground">#0C0C0D</item>
        <item name="colorOnBackground">#F2F2F3</item>
        <item name="colorSurface">#0C0C0D</item>
        <item name="colorOnSurface">#F2F2F3</item>
        <item name="colorSurfaceVariant">#1C1D20</item>
        <item name="colorOnSurfaceVariant">#A8ADB3</item>
        <item name="colorOutline">#5C5E62</item>
