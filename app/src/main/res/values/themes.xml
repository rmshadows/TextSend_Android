        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="tsFieldStroke">#C4B0FF</item>
    </style>

    <style name="Theme.Textsend" parent="Base.Theme.Textsend" />

    <!-- 暗色：近黑、中性灰，去掉默认紫。 -->
    <style name="Theme.Textsend.Dark" parent="Theme.Material3.Dark.NoActionBar">
